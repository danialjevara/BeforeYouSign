# Enforce consistent line endings across platforms
* text=auto eol=lf

# Dart sources
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows-specific
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
